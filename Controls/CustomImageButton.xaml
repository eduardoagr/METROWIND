<ContentView
    x:Class="METROWIND.Controls.CustomImageButton"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="ImageButton">

    <VerticalStackLayout BindingContext="{x:Binding Source={x:Reference ImageButton}}">
        <Border
            Margin="10"
            Padding="10"
            HorizontalOptions="Start"
            Stroke="{x:Binding BorderColor}"
            StrokeThickness="2">
            <Label
                FontFamily="ma"
                FontSize="Large"
                Text="{x:Binding ImageName}"
                TextColor="Black"
                VerticalOptions="Center" />
        </Border>

        <Label
            Margin="0,-10,0,0"
            HorizontalTextAlignment="Center"
            Text="{x:Binding Caption}"
            TextColor="Black" />
        <VerticalStackLayout.GestureRecognizers>
            <TapGestureRecognizer
                Command="{x:Binding ClickCommand}"
                CommandParameter="{x:Binding Parameter}" />
        </VerticalStackLayout.GestureRecognizers>
    </VerticalStackLayout>
</ContentView>
