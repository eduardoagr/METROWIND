<ContentView
    x:Class="METROWIND.Controls.CustomImageButton"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="ImageButton"
    xmlns:cc="clr-namespace:METROWIND.Controls"
    x:DataType="cc:CustomImageButton">

    <HorizontalStackLayout BindingContext="{x:Binding Source={x:Reference ImageButton}}">
        <Border
            Margin="10"
            HeightRequest="{OnIdiom Desktop=40,
                                    Phone=60}"
            Stroke="{x:Binding BorderColor}"
            StrokeThickness="2"
            WidthRequest="{OnIdiom Desktop=40,
                                   Phone=60}">
            <Label
                FontFamily="ma"
                FontSize="{OnIdiom Desktop=40,
                                   Phone=60}"
                Text="{x:Binding ImageName}"
                TextColor="Black" />
        </Border>

        <Label
            HorizontalTextAlignment="Center"
            Text="{x:Binding Caption}"
            TextColor="Black"
            Margin="5"
            VerticalTextAlignment="Center" />
        <HorizontalStackLayout.GestureRecognizers>
            <TapGestureRecognizer
                Command="{x:Binding ClickCommand}"
                CommandParameter="{x:Binding Parameter}" />
        </HorizontalStackLayout.GestureRecognizers>
    </HorizontalStackLayout>
</ContentView>
