<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="METROWIND.Views.NewsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:constants="clr-namespace:METROWIND.Constants"
    xmlns:converters="clr-namespace:METROWIND.Converters"
    xmlns:models="clr-namespace:METROWIND.Models"
    xmlns:rex="clr-namespace:METROWIND.Resources"
    xmlns:vm="clr-namespace:METROWIND.ViewModel"
    x:DataType="vm:NewsPageViewModel">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:ImgSourceConverter x:Key="ImgSourceConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <Grid
        Padding="16,0,16,0"
        RowDefinitions="Auto,*">

        <Label
            Margin="20"
            FontAttributes="Bold"
            FontSize="Large"
            HorizontalTextAlignment="Center"
            Text="{x:Static rex:AppResource.WhatsNew}"
            VerticalTextAlignment="Center" />


        <CollectionView
            Grid.Row="1"
            ItemsSource="{x:Binding ArticleList}"
            SelectionMode="None">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout
                    ItemSpacing="10"
                    Orientation="Vertical" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyViewTemplate>
                <DataTemplate>
                    <VerticalStackLayout
                        HorizontalOptions="CenterAndExpand"
                        VerticalOptions="CenterAndExpand">
                        <ActivityIndicator IsRunning="True" />
                        <Label
                            HorizontalOptions="Center"
                            Text="{x:Static rex:AppResource.Loading}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.EmptyViewTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Article">
                    <Border>
                        <Grid
                            Padding="10"
                            RowDefinitions="250,Auto,Auto,Auto">

                            <Image
                                Aspect="AspectFill"
                                HeightRequest="250"
                                Source="{x:Binding UrlToImage}"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Row="1"
                                Margin="0,10,0,0"
                                FontAttributes="Bold"
                                FontSize="Large"
                                Text="{x:Binding Title}" />

                            <HorizontalStackLayout
                                Grid.Row="2"
                                Margin="0,20,0,10">
                                <Label
                                    FontFamily="ma"
                                    FontSize="Large"
                                    Text="{x:Static constants:MaterialFonts.Newspaper}"
                                    VerticalTextAlignment="Center" />
                                <Label
                                    Margin="10,0,0,0"
                                    Text="{x:Binding Source.Name}"
                                    VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>

                            <Grid
                                Grid.Row="4"
                                Margin="0,5,0,0"
                                ColumnDefinitions="Auto,*,Auto">
                                <Label
                                    FontFamily="ma"
                                    FontSize="Large"
                                    Text="{x:Static constants:MaterialFonts.Person}" />
                                <Label
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    Text="{x:Binding Author,
                                                     TargetNullValue='Author uknown'}" />
                                <Label
                                    Grid.Column="2"
                                    Text="{x:Binding PublishedAt}" />
                            </Grid>
                        </Grid>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{x:Binding ShowNewsDetailCommand,
                                                    Source={x:RelativeSource AncestorType={x:Type vm:NewsPageViewModel}}}"
                                CommandParameter="{x:Binding .}" />
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>