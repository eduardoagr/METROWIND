<?xml version="1.0" encoding="utf-8" ?>
<sfPopup:SfPopup    
    x:Class="METROWIND.Views.NoInternetPopUp"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:rex="clr-namespace:METROWIND.Resources"
    xmlns:sfPopup="clr-namespace:Syncfusion.Maui.Popup;assembly=Syncfusion.Maui.Popup"
    xmlns:skiaLottie="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
    ShowFooter="False"
    ShowHeader="False"
    StaysOpen="True">

    <sfPopup:SfPopup.ContentTemplate>
        <DataTemplate>
            <VerticalStackLayout>
                <Image
                    Margin="20"
                    HeightRequest="100"
                    HorizontalOptions="Center"
                    Source="no_internet.png"
                    VerticalOptions="Center"
                    WidthRequest="100" />
                <Label
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    Text="{x:Static rex:AppResource.Internet}"
                    TextColor="Black" />
            </VerticalStackLayout>
        </DataTemplate>
    </sfPopup:SfPopup.ContentTemplate>
</sfPopup:SfPopup>

